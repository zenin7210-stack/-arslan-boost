
test('quoted wallet amount bumps by 100, is not reserved by quote, and credits exactly the cash received',async t=>{
  t.mock.method(globalThis,'fetch',async ()=>Response.json({ok:true,result:{message_id:555}}));
  const system=app();
  const request={amount:10000,method:'uzcard'};
  const firstQuote=await system.api(1,'invoice/quote',request);
  assert.deepEqual([firstQuote.status,firstQuote.data.uniqueAmount,firstQuote.data.baseAmount],[200,10000,10000]);
  assert.equal(system.db.prepare('SELECT COUNT(*) AS n FROM invoices').get().n,0,'quote must be read-only');
  const first=await system.api(1,'invoice',{...request,requestId:'wallet-1'});
  assert.equal(first.data.uniqueAmount,10000);
  const nextQuote=await system.api(2,'invoice/quote',request);
  assert.equal(nextQuote.data.uniqueAmount,10100);
  assert.equal(system.db.prepare('SELECT COUNT(*) AS n FROM invoices').get().n,1);
  const second=await system.api(2,'invoice',{...request,requestId:'wallet-2'});
  assert.deepEqual([second.status,second.data.baseAmount,second.data.uniqueAmount],[200,10000,10100]);
  const third=await system.api(3,'invoice',{...request,requestId:'wallet-3'});
  assert.equal(third.data.uniqueAmount,10200);
  const existing=await system.api(2,'invoice',{...request,requestId:'wallet-2'});
  assert.equal(existing.data.id,second.data.id);
  assert.equal((await system.api(2,'invoice/quote',request)).data.existing,true);
  assert.equal(system.db.prepare('SELECT COUNT(*) AS n FROM invoices').get().n,3);
  const before=await system.api(2,'invoice/'+second.data.id+'/status',null,'GET');
  assert.deepEqual([before.data.status,before.data.balance],['pending',0]);
  const falseClaim=await system.api(2,'invoice/'+second.data.id+'/check',{});
  assert.equal(falseClaim.data.status,'pending');
  assert.equal(falseClaim.data.balance,0);
  const bank={sender:'BankDemo',eventId:'sms:exact100',text:notification(10100,'BANK10100TEST')};
  const settled=await system.relay(bank);
  assert.equal(settled.data.matched,true);
  assert.equal((await system.relay({...bank,eventId:'sms:exact101'})).data.duplicate,true);
  await system.drain();
  const after=await system.api(2,'invoice/'+second.data.id+'/status',null,'GET');
  assert.deepEqual([after.data.status,after.data.balance],['paid',10100]);
  const invoice=system.db.prepare('SELECT requested_amount,base_amount,unique_amount FROM invoices WHERE id=?').get(second.data.id);
  assert.deepEqual([invoice.requested_amount,invoice.base_amount,invoice.unique_amount],[10000,10100,10100]);
  assert.equal((await system.api(2,'state')).data.starsBalance,0,'Stars must not be affected');
});
test('new bank order retains exact advertised price and cannot silently acquire a surcharge',async t=>{
  t.mock.method(globalThis,'fetch',async ()=>Response.json({ok:true,result:{message_id:5}}));
  const system=app();
  const first=await system.api(1,'invoice',{amount:12000,method:'uzcard',requestId:'reserve-12000'});
  assert.equal(first.data.uniqueAmount,12000);
  const boost={fromIndex:1,toIndex:2,mode:'wing',gameId:'23456',expectedAmount:12000,
    paymentMethod:'uzcard',requestId:'boost-no-extra-fee'};
  const second=await system.api(2,'checkout',boost);
  assert.deepEqual([second.status,second.data.error],[409,'p2p_amount_unavailable']);
});

test('stale checked card transfer is recoverable; active new one uses another exact sum',async t=>{
  t.mock.method(globalThis,'fetch',async()=>Response.json({ok:true,result:{message_id:9}}));
  const sys=app();
  const request={amount:10000,method:'uzcard',requestId:'first-expired-checked'};
  const first=await sys.api(1,'invoice',request);
  assert.equal(first.status,200);
  assert.equal(first.data.canCancel,true);
  const click=await sys.api(1,'invoice/'+first.data.id+'/check',{});
  assert.equal(click.status,200);
  assert.equal(click.data.canCancel,false);
  const badCancel=await sys.api(1,'invoice/'+first.data.id+'/cancel',{});
  assert.equal(badCancel.status,409,'Do not cancel an invoice already marked as transferred');
  sys.db.prepare("UPDATE invoices SET created_at = created_at - 1900, expires_at = expires_at - 1900, checked_at = checked_at - 1900 WHERE id=?")
    .run(first.data.id);
  const options=await sys.api(1,'invoice/options',{});
  assert.equal(options.status,200);
  assert.equal(options.data.active,null,'A stale checked transfer does not block the account');
  const history=await sys.api(1,'invoice/'+first.data.id+'/status',null,'GET');
  assert.equal(history.data.status,'expired');
  const next=await sys.api(1,'invoice',{amount:10000,method:'uzcard',requestId:'new-after-expired-checked'});
  assert.equal(next.status,200);
  assert.equal(next.data.uniqueAmount,10100,'Keep old exact sum isolated for delayed bank notice');
  assert.equal((await sys.api(1,'invoice/quote',{amount:10000,method:'uzcard'})).data.existing,true);
  const before=await sys.api(1,'invoice/'+next.data.id+'/status',null,'GET');
  assert.equal(before.data.balance,0);
  const delayed={sender:'BankDemo',eventId:'old-bank-after-expiry',text:notification(10000,'BANK-OLD-AFTER-EXPIRY',
    new Date((first.data.createdAt-1800) * 1000).toISOString())};
  const result=await sys.relay(delayed);
  assert.equal(result.data.matched,true);
  await sys.drain();
  const earlier=await sys.api(1,'invoice/'+first.data.id+'/status',null,'GET');
  const later=await sys.api(1,'invoice/'+next.data.id+'/status',null,'GET');
  assert.equal(earlier.data.status,'paid');
  assert.equal(later.data.status,'pending','Delayed bank transfer must not pay a newly created invoice');
  assert.equal(later.data.balance,10000,'One real bank event is credited exactly once');
});

test('loading bank options and quoting amount does not execute mutating batch statements',async()=>{
  const sys=app();
  sys.env.DB.batch=async()=>{throw new Error('unsafe expiry write on read-only screen load');};
  const options=await sys.api(1,'invoice/options',{});
  assert.equal(options.status,200,'loading wallet should not invoke expiry writes');
  assert.deepEqual(options.data.methods.sort(),['humo','uzcard']);
  const quote=await sys.api(1,'invoice/quote',{amount:10000,method:'uzcard'});
  assert.equal(quote.status,200);
  assert.equal(quote.data.uniqueAmount,10000);
});
test('an old cancelled wallet request is visible in read-only options',async()=>{
  const sys=app();
  const first=await sys.api(1,'invoice',{amount:10000,method:'uzcard',requestId:'cancel-wallet-1'});
  assert.equal(first.status,200);
  const cancelled=await sys.api(1,'invoice/'+first.data.id+'/cancel',{});
  assert.equal(cancelled.data.status,'cancelled');
  const options=await sys.api(1,'invoice/options',{});
  assert.equal(options.status,200);
  assert.equal(options.data.active,null);
  assert.equal(options.data.latest.id,first.data.id);
  assert.equal(options.data.latest.status,'cancelled');
});

test('pending bank invoice always appears in recovery, its owner can cancel and open a new one', async()=>{
  const system=app();
  const empty=await system.api(1,'invoice/recover',{});
  assert.equal(empty.status,200);
  assert.equal(empty.data.active,null);
  const old=await system.api(1,'invoice',{amount:10000,method:'uzcard',requestId:'old-recover-001'});
  assert.equal(old.status,200);
  const recovered=await system.api(1,'invoice/recover',{});
  assert.equal(recovered.status,200);
  assert.equal(recovered.data.active.id,old.data.id);
  assert.equal(recovered.data.active.canCancel,true);
  const options=await system.api(1,'invoice/options',{});
  assert.equal(options.status,200);
  assert.equal(options.data.active.id,old.data.id);
  const cancel=await system.api(1,'invoice/'+old.data.id+'/cancel',{});
  assert.equal(cancel.data.status,'cancelled');
  assert.equal((await system.api(1,'invoice/recover',{})).data.active,null);
  const next=await system.api(1,'invoice',{amount:50000,method:'uzcard',requestId:'new-after-cancel'});
  assert.equal(next.status,200);
  assert.equal(next.data.status,'pending');
});
test('bank invoice loading bypasses Stars checkout settings but still rejects unauthenticated access',async()=>{
  const system=app();
  const original=system.env.DB.prepare.bind(system.env.DB);
  system.env.DB.prepare=sql=>{
    if(sql.includes('checkout_webhook_url'))throw Error('Simulated Stars settings outage');
    return original(sql);
  };
  const result=await system.api(1,'invoice/options',{});
  assert.equal(result.status,200);
  assert.ok(result.data.methods.includes('uzcard'));
  const unauthorized=await system.send('/api/invoice/recover',{},{});
  assert.equal(unauthorized.status,401);
});

test('unexpected auth/role runtime errors produce stable safe P2P error codes',async()=>{
  const sys=app({P2P_USERS:{unexpected:'not-string'}});
  const res=await sys.api(1,'invoice/options',{});
  assert.equal(res.status,503);
  assert.equal(res.data.error,'p2p_handler_type_failed');
});
test('D1 error while reading invoice options identifies failing stage',async()=>{
  const sys=app();
  const prepare=sys.env.DB.prepare.bind(sys.env.DB);
  sys.env.DB.prepare=sql=>{
    if(sql.includes("FROM invoices WHERE user_id = ? AND status = 'pending' AND expires_at > ?"))
      throw new Error('Synthetic unavailable D1 in test only');
    return prepare(sql);
  };
  const res=await sys.api(1,'invoice/options',{});
  assert.equal(res.status,503);
  assert.equal(res.data.error,'p2p_options_current_failed');
});
