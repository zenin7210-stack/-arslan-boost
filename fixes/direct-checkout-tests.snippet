
test('DONAT Stars is disabled while BOOST Stars payment remains available',async t=>{
  t.mock.method(globalThis,'fetch',async(url)=>Response.json({
    ok:true,result:url.endsWith('/createInvoiceLink')?'https://t.me/$boost-stars-test':true
  }));
  const system=app();
  const blocked=await system.api(1,'donat/create',{
    product:'spin_coins',option:'100',detail:'123456',
    expectedAmount:21990,paymentMethod:'stars',acceptTerms:true,requestId:'donat-stars-blocked'
  });
  assert.equal(blocked.status,409);
  assert.equal(blocked.data.error,'invalid_payment_method');
  assert.equal(system.db.prepare("SELECT COUNT(*) AS n FROM donat_orders").get().n,0);
  const boost=await system.api(1,'checkout',{
    mode:'wing',fromIndex:0,toIndex:3,gameId:'TEST12345',
    expectedAmount:13000,paymentMethod:'stars',acceptTerms:true,requestId:'boost-stars-still-works'
  });
  assert.equal(boost.status,200);
  assert.equal(boost.data.payment.method,'stars');
  assert.equal(boost.data.payment.kind,'order');
  assert.ok(boost.data.payment.invoiceLink);
});
test('Only three direct payment methods: balance and new wallet top-ups are disabled without erasing old balances',async()=>{
  const system=app();
  const before=(await system.api(1,'state')).data;
  const disabledStarsTopup=await system.api(1,'topup',{stars:10,starsRate:160,paymentMethod:'stars',acceptTerms:true,requestId:'no-topup-1'});
  assert.deepEqual([disabledStarsTopup.status,disabledStarsTopup.data.error],[409,'topup_disabled']);
  const disabledCardTopup=await system.api(1,'invoice',{amount:10000,method:'uzcard',requestId:'no-topup-2'});
  assert.deepEqual([disabledCardTopup.status,disabledCardTopup.data.error],[409,'topup_disabled']);
  const invalid=await system.api(1,'donat/create',{
    product:'spin_coins',option:'100',detail:'123456',expectedAmount:21990,
    paymentMethod:'balance',requestId:'no-balance-payment'});
  assert.equal(invalid.data.error,'invalid_payment_method');
  const after=(await system.api(1,'state')).data;
  assert.deepEqual([after.balance,after.starsBalance],[before.balance,before.starsBalance]);
});
test('Existing confirmed P2P card order still creates a linked invoice without wallet prepayment',async()=>{
  const system=app();
  const data={product:'spin_coins',option:'100',detail:'123456',expectedAmount:21990,
    paymentMethod:'uzcard',requestId:'donat-direct-card-order-001'};
  const placed=await system.api(1,'donat/create',data);
  assert.equal(placed.status,200);
  assert.equal(placed.data.amount,21990);
  assert.ok(placed.data.invoiceId>0);
  const duplicate=await system.api(1,'donat/create',data);
  assert.equal(duplicate.data.id,placed.data.id);
  const check=await system.api(1,'invoice/'+placed.data.invoiceId+'/check',{});
  assert.equal(check.data.status,'pending');
  const wallet=(await system.api(1,'state')).data;
  assert.equal(wallet.balance,0);
});

test('a busy bank amount selects +100 for the next customer without altering product price',async()=>{
  const system=app();
  const make=(id,key)=>system.api(id,'donat/create',{
    product:'spin_coins',option:'100',detail:'123456',expectedAmount:21990,
    paymentMethod:'uzcard',requestId:key
  });
  const first=await make(1,'same-amount-first');
  assert.equal(first.status,200);
  const second=await make(2,'same-amount-second');
  assert.equal(second.status,200);
  const third=await make(3,'same-amount-third');
  assert.equal(third.status,200);
  for(const [index,result] of [first,second,third].entries()){
    assert.equal(result.data.amount,21990);
    const invoice=system.db.prepare('SELECT * FROM invoices WHERE id=?').get(result.data.invoiceId);
    assert.equal(invoice.requested_amount,21990);
    assert.equal(invoice.unique_amount,21990+index*100);
    assert.equal(invoice.base_amount,invoice.unique_amount);
    const payment=system.db.prepare('SELECT * FROM payments WHERE id=?').get(invoice.order_payment_id);
    assert.equal(payment.amount,21990);
  }
  const duplicated=await make(2,'same-amount-second');
  assert.equal(duplicated.data.id,second.data.id);
  assert.equal(duplicated.data.invoiceId,second.data.invoiceId);
  assert.equal(system.db.prepare("SELECT COUNT(*) AS n FROM invoices WHERE status='pending'").get().n,3);
  const verified=await system.relay({sender:'BankDemo',text:notification(22090,'BANKALTERNATE200')});
  assert.equal(verified.data.matched,true,JSON.stringify({status:verified.status,error:verified.data.error,detail:verified.data.detail}));
  assert.equal(verified.data.invoiceId,second.data.invoiceId);
  const after=(await system.api(2,'invoice/'+second.data.invoiceId+'/status',null,'GET')).data;
  assert.equal(after.status,'paid');
  assert.equal((await system.api(2,'donat/state')).data.orders[0].status,'paid');
  assert.equal((await system.api(1,'invoice/'+first.data.invoiceId+'/status',null,'GET')).data.status,'pending');
  assert.equal((await system.api(3,'invoice/'+third.data.invoiceId+'/status',null,'GET')).data.status,'pending');
  assert.equal((await system.api(2,'state')).data.balance,0,'Direct order must not credit wallet');
});
test('new orders never reserve below listed price and can recover from a cancelled unpaid order',async()=>{
  const system=app();
  const payload={product:'spin_coins',option:'100',detail:'123456',expectedAmount:21990,
    paymentMethod:'uzcard'};
  const old=await system.api(1,'donat/create',{...payload,requestId:'order-before-cancel'});
  assert.equal(old.status,200);
  const blocked=await system.api(1,'donat/create',{...payload,requestId:'order-after-blocked'});
  assert.ok(['order_already_active','p2p_invoice_in_progress'].includes(blocked.data.error));
  const cancellation=await system.api(1,'invoice/'+old.data.invoiceId+'/cancel',{});
  assert.equal(cancellation.data.status,'cancelled');
  const replacement=await system.api(1,'donat/create',{...payload,requestId:'order-after-blocked'});
  assert.equal(replacement.status,200);
  const invoice=system.db.prepare('SELECT * FROM invoices WHERE id=?').get(replacement.data.invoiceId);
  assert.ok(invoice.unique_amount>=21990);
});
