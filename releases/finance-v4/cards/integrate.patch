+function telegramParams(body) {
+  if (!(body instanceof FormData)) return JSON.parse(body);
+  const p=Object.fromEntries(body);
+  if(p.media) p.media=JSON.parse(p.media);
+  if(p.reply_markup) p.reply_markup=JSON.parse(p.reply_markup);
+  return p;
+}
