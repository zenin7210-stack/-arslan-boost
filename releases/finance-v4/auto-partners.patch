+  const words=normalized.split(/\s+/u);
+  if(words.length>4||!words.every(w=>/^[\p{L}][\p{L}.'’*-]*$/u.test(w)))return null;
+  if(words.some(w=>['market','shop','mchj','ooo','магазин','банк','bank','payme','llc'].includes(w)))return null;
+  const found=words.map(w=>partnerNames.get(w)).filter(Boolean);
+  return found.length===1?found[0]:null;
+}
