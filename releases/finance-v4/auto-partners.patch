+  // Only use a bank recipient field or the destination segment of a P2P descriptor.
+  const fields=[...norm(raw).matchAll(/^[^\p{L}\p{N}\r\n]*(?:получатель(?: перевода)?|кому|recipient|beneficiary|qabul qiluvchi|oluvchi)\s*[:：]\s*([^\r\n]+)$/gimu)];
