+    const recipients=fields.map(m=>identifyName(m[1]));
+    return recipients[0] && recipients.every(v=>v===recipients[0])?recipients[0]:null;
+  }
+  const transfer=merchant.match(/\b(?:P2P|H2U|U2H|H2H|CARD2CARD)\b[^>\n]*>\s*([^>\n]+)$/iu);
+  return identifyName(transfer?transfer[1]:merchant,true);
+}
