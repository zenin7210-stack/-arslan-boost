index 0000000..33d81ef
--- /dev/null
+++ b/migrations/0019_v9_lease_and_amounts.sql
@@ -0,0 +1,20 @@
+-- V9: Non-destructive lease shortening. The old expires_at CHECK
+-- (expires_at=created_at+600) remains intact for historical invoices.
+-- Old invoices have NULL lease_expires_at and keep the V8 deadline.
+ALTER TABLE invoices ADD COLUMN lease_expires_at INTEGER
+  CHECK (lease_expires_at IS NULL OR lease_expires_at <= expires_at);
+CREATE INDEX IF NOT EXISTS p2p_v9_lease_lookup
+  ON invoices(card_id, unique_amount, lease_expires_at);
+-- Two concurrent purchases cannot reserve the same card + amount while the
+-- previous invoice is active or within the 10-minute late-notice quarantine.
+-- IGNORE keeps the transaction free of false payment/order records.
+CREATE TRIGGER IF NOT EXISTS p2p_v9_reservation_collision
+BEFORE INSERT ON invoices
+WHEN EXISTS (
+  SELECT 1 FROM invoices previous
+  WHERE previous.card_id = NEW.card_id AND previous.unique_amount = NEW.unique_amount
+    AND COALESCE(previous.cancelled_at, previous.lease_expires_at, previous.expires_at) + 600 > NEW.created_at
+)
+BEGIN
+  SELECT RAISE(IGNORE);
+END;
