diff --git a/src/group-ai.mjs b/src/group-ai.mjs
new file mode 100644
index 0000000..5c732ad
--- /dev/null
+++ b/src/group-ai.mjs
@@ -0,0 +1,158 @@
+import { telegram, botToken } from './telegram.mjs';
+
+const mainModel = '@cf/openai/gpt-oss-120b';
+const backupModel = '@cf/meta/llama-3.3-70b-instruct-fp8-fast';
+const strings = {
+  uz: { ask:'Savolingizni yozing.', wait:'Savollar juda tez kelyapti. Bir daqiqadan keyin yana yozing.',
+    unavailable:'AI bilan aloqa uzildi. Savolni yana yuborishingiz mumkin.' },
+  ru: { ask:'Напиши свой вопрос.', wait:'Слишком много вопросов подряд. Попробуй через минуту.',
+    unavailable:'Связь с ИИ прервалась. Можешь отправить вопрос ещё раз.' }
+};
+
+function language(text, previous) {
+  const s=text.toLowerCase();
+  if (/(?:по[- ]русски|на русском|ruscha(?:da)?|rus tilida|рус тилида)/u.test(s)) return 'ru';
+  if (/(?:по[- ]узбекски|на узбекском|o[‘’ʻ'ʼ`]?zbek(?:cha| tilida)|ўзбекча)/u.test(s)) return 'uz';
+  if (/[ўқғҳ]|(?:салом|нима|қанча|канча|керак|рахмат|менга|яхши|сизга|калесан|бўлади|килиб|учун|булди|неча|киласиз)/u.test(s)) return 'uz';
+  if (/[а-яё]{2,}/u.test(s) || /\b(?:privet|skolko|pochemu|spasibo|kak dela)\b/.test(s)) return 'ru';
+  return /[a-z]{2,}/i.test(s) ? 'uz' : previous || 'uz';
+}
+
+function basicAnswer(text,lang) {
+  if (!text) return strings[lang].ask;
+  const clean=text.toLowerCase().trim().replace(/[?!., ]+$/u,'');
+  if (/^(?:привет|здравствуй(?:те)?|салом|salom|assalomu alaykum|ассалому алайкум|йо|yo|privet)$/.test(clean)) {
+    return lang==='ru'?'Привет! Чем помочь?':'Salom! Qanday yordam beray?';
+  }
+  // Accept only a complete arithmetic expression. Never evaluate code or a fragment of a question.
+  const expression=text.trim().replace(/^(?:(?:сколько(?: будет)?|посчитай|hisobla|hisoblang|qancha)\s*[:=]?\s*)/i,'')
+    .replace(/\s*(?:nech[ia]|qancha|ga teng)?\s*[=?!.]*$/iu,'').replace(/[,]/g,'.').replace(/[×хx]/g,'*').replace(/÷/g,'/').replace(/−/g,'-');
+  if (expression.length>100 || !/^[\d\s.()+*/-]+$/.test(expression) || !/[+*/-]/.test(expression)) return null;
+  const parts=expression.match(/\d+(?:\.\d+)?|[()+*/-]|[^\s]/g) || [];
+  let i=0;
+  function atom() {
+    const token=parts[i++];
+    if (token==='-') return -atom();
+    if (token==='+') return atom();
+    if (token==='(') { const n=sum(); return parts[i++]===')'? n : NaN; }
+    return /^\d+(\.\d+)?$/.test(token || '') ? Number(token) : NaN;
+  }
+  function product() {
+    let n=atom();
+    while (parts[i]==='*'||parts[i]==='/') {const op=parts[i++];const b=atom();n=op==='*'?n*b:n/b;}
+    return n;
+  }
+  function sum() {
+    let n=product();
+    while (parts[i]==='+'||parts[i]==='-') {const op=parts[i++];const b=product();n=op==='+'?n+b:n-b;}
+    return n;
+  }
+  const n=sum();
+  return i===parts.length && Number.isFinite(n) && Math.abs(n)<=1e12 ? String(Number(n.toPrecision(13))) : null;
+}
+
+function addressed(m,name,botId) {
+  const text=m.text || m.caption || '';
+  if (!text || !name) return null;
+  const command=new RegExp('^/ai(?:@'+name+')?(?:\\s|$)','i');
+  const mention=new RegExp('(?<![\\p{L}\\p{N}_@])@'+name+'(?![a-z0-9_])','giu');
+  const reply=m.reply_to_message;
+  const ownReply=reply?.from?.is_bot && reply.from.id===botId;
+  if (text.startsWith('/') ? !command.test(text) : !ownReply && !mention.test(text)) return null;
+  return { question:text.replace(command,'').replace(mention,'').trim().replace(/^[,:]\s*/, '').slice(0,1800),
+    reply:ownReply?reply:null };
+}
+
+function messagesFor(question,history,lang) {
+  const policy='You are Arslan, a helpful participant in the ARSLAN CHAT Telegram group. Answer the actual question directly, naturally and accurately. Use short plain-text paragraphs. Russian input gets natural Russian. Uzbek input (Latin, Cyrillic or informal Uzbek) gets natural Uzbek in Latin script unless a different script is requested. Follow explicit language requests. Uzbek is the default for ambiguous input. For a greeting greet naturally. For a follow-up use only the conversation supplied. Do not invent prices, game IDs, order status, access, or completed actions. If the user asks, the shop is @arslansavdo and the admin is @khblyv. Do not advertise in unrelated answers.';
+  return [{role:'system',content:policy+' Likely answer language: '+(lang==='ru'?'Russian.':'Uzbek.')},
+    ...history,{role:'user',content:question}];
+}
+
+function finalText(result) {
+  const value=result?.response ?? result?.choices?.[0]?.message?.content ?? result?.output_text ??
+    result?.output?.filter(x=>x.type==='message').flatMap(x=>x.content || []).filter(x=>x.type==='output_text').map(x=>x.text).join('\n');
+  if(typeof value!=='string') return '';
+  // Some inference APIs expose analysis separately. Only send the final user-visible text.
+  if(value.includes('<think>') && !value.includes('</think>')) return '';
+  return value.replace(/<think>[\s\S]*?<\/think>/gi,'').trim().slice(0,3000);
+}
+
+async function inference(env,messages) {
+  for (const model of [mainModel,backupModel]) {
+    let timer;
+    try {
+      const timeout=new Promise((_,reject)=>{timer=setTimeout(()=>reject(new Error('inference_timeout')),15000);});
+      const result=await Promise.race([env.AI.run(model,{messages,max_tokens:900,temperature:0.35}),timeout]);
+      const text=finalText(result);
+      if (text) return {text,model};
+      console.warn('Arslan group AI: empty output',model);
+    } catch (error) {
+      const code=String(error?.message || '').match(/\b(?:[1-9]\d{3}|429|500|502|503|504)\b/)?.[0];
+      console.warn('Arslan group AI: inference failed',model,code || (error?.message==='inference_timeout'?'timeout':'unavailable'));
+    } finally { clearTimeout(timer); }
+  }
+  return null;
+}
+
+export async function answerGroupQuestion(env,store,config,m) {
+  const target=addressed(m,config.name,Number(botToken(env).split(':')[0]));
+  if (!target) return;
+  const {question,reply}=target;
+  const chat=m.chat.id, author=m.from.id, mid=m.message_id;
+  const prior=reply?.message_id ? await store.first(`SELECT history,lang FROM group_ai_replies WHERE chat=? AND sent_mid=? AND author=? AND stamp>unixepoch()-600`,
+    chat,reply.message_id,author) : null;
+  const history=prior?.history ? JSON.parse(prior.history) : reply?.text ? [{role:'assistant',content:reply.text.slice(0,900)}] : [];
+  const lang=language(question,prior?.lang);
+  const quick=basicAnswer(question,lang);
+  const owner=crypto.randomUUID();
+  const results=await store.db.batch([
+    store.stmt(`INSERT INTO group_ai_replies(chat,mid,author,lang,mode)
+      SELECT ?,?,?,?,CASE WHEN ?=1 THEN 'local'
+        WHEN (SELECT count(*) FROM group_ai_replies WHERE chat=? AND author=? AND stamp>unixepoch()-60 AND mode='ai')>=12
+          OR (SELECT count(*) FROM group_ai_replies WHERE chat=? AND stamp>unixepoch()-60 AND mode='ai')>=50 THEN 'wait'
+        ELSE 'ai' END ON CONFLICT DO NOTHING`,chat,mid,author,lang,Number(quick!==null),chat,author,chat),
+    store.stmt(`UPDATE group_ai_replies SET lease=unixepoch()+45,owner=?
+      WHERE chat=? AND mid=? AND sent_mid IS NULL AND lease<=unixepoch() RETURNING mode,answer,history`,owner,chat,mid)
+  ]);
+  const job=results[1].results[0];
+  if (!job) return;
+  try {
+    let answer=job.answer;
+    if (!answer) {
+      const result=job.mode==='ai' ? await inference(env,messagesFor(question,history,lang)) : null;
+      answer=job.mode==='wait' ? strings[lang].wait : quick ?? result?.text ?? strings[lang].unavailable;
+      const next=job.mode!=='wait' && (quick!==null || result) ?
+        [...history,{role:'user',content:question},{role:'assistant',content:answer}].slice(-6).map(x=>({...x,content:x.content.slice(0,900)})) : history;
+      const saved=await store.first('UPDATE group_ai_replies SET answer=?,history=? WHERE chat=? AND mid=? AND owner=? RETURNING mid',
+        answer,JSON.stringify(next),chat,mid,owner);
+      if (!saved) return;
+    }
+    const sent=await telegram(env,'sendMessage',{chat_id:chat,text:answer,
+      reply_parameters:{message_id:mid,allow_sending_without_reply:true},
+      ...(m.message_thread_id?{message_thread_id:m.message_thread_id}:{})});
+    await store.stmt('UPDATE group_ai_replies SET sent_mid=?,lease=0 WHERE chat=? AND mid=? AND owner=?',sent.message_id,chat,mid,owner).run();
+  } catch(e) {
+    await store.stmt('UPDATE group_ai_replies SET lease=0 WHERE chat=? AND mid=? AND owner=?',chat,mid,owner).run();
+    throw e;
+  }
+}
+
+// Verify the deployed AI binding once per chat release using public test questions only.
+// Health requests only read these results and cannot trigger inference.
+export const aiRevision='bilingual-15';
+export async function verifyGroupModels(env,store) {
+  if (!env.AI || env.TELEGRAM_TEST_ENV!=='0') return;
+  const claim=await store.first(`INSERT INTO group_ai_checks(revision,attempts,stamp) VALUES(?,1,unixepoch())
+    ON CONFLICT(revision) DO UPDATE SET attempts=attempts+1,stamp=unixepoch()
+    WHERE (ru=0 OR uz=0) AND attempts<3 AND stamp<=unixepoch()-45 RETURNING ru,uz`,aiRevision);
+  if (!claim) return;
+  const probes=[['ru','Зачем в шахматах контролировать центр? Ответь одним предложением.'],
+    ['uz','Shaxmatda markazni nazorat qilish nega foydali? Bir jumlada javob bering.']];
+  for (const [lang,question] of probes) {
+    if (claim[lang]) continue;
+    const answer=await inference(env,messagesFor(question,[],lang));
+    const ok=lang==='ru' ? /[а-яё]{3,}/i.test(answer?.text || '') : /(?:shaxmat|markaz|nazorat|donal|harakat|imkon|yurish|raqib|hujum)/i.test(answer?.text || '');
+    if(ok) await store.stmt('UPDATE group_ai_checks SET '+lang+'=1,'+lang+'_model=? WHERE revision=?',answer.model,aiRevision).run();
+  }
+}
diff --git a/src/group-chat.mjs b/src/group-chat.mjs
new file mode 100644
index 0000000..5fabbb6
--- /dev/null
+++ b/src/group-chat.mjs
@@ -0,0 +1,176 @@
+import { telegram, botToken } from './telegram.mjs';
+import { welcomeMembers, deleteDueWelcomes, importWelcome } from './group-welcome.mjs';
+import { answerGroupQuestion, verifyGroupModels, aiRevision } from './group-ai.mjs';
+
+const initialized = new WeakMap();
+function ready(db) {
+  if (!initialized.has(db)) {
+    const sql = [
+      `CREATE TABLE IF NOT EXISTS group_preferences(chat INTEGER PRIMARY KEY, enabled INTEGER DEFAULT 0, welcome INTEGER DEFAULT 0, mode TEXT DEFAULT 'normal', greeting TEXT)`,
+      'CREATE TABLE IF NOT EXISTS group_activity(chat INTEGER, mid INTEGER, author INTEGER, fingerprint TEXT, blocked INTEGER, stamp INTEGER DEFAULT (unixepoch()), PRIMARY KEY(chat,mid))',
+      'CREATE INDEX IF NOT EXISTS group_sender_window ON group_activity(chat,author,stamp)',
+      'CREATE INDEX IF NOT EXISTS group_activity_age ON group_activity(stamp)',
+      'CREATE TABLE IF NOT EXISTS group_extras(chat INTEGER PRIMARY KEY, template TEXT, ai INTEGER)',
+      'CREATE TABLE IF NOT EXISTS group_ai_turns(chat INTEGER,mid INTEGER,author INTEGER,stamp INTEGER DEFAULT (unixepoch()),PRIMARY KEY(chat,mid))',
+      'CREATE INDEX IF NOT EXISTS group_turn_time ON group_ai_turns(chat,stamp)',
+      'CREATE TABLE IF NOT EXISTS group_ai_replies(chat INTEGER,mid INTEGER,author INTEGER,stamp INTEGER DEFAULT (unixepoch()),lang TEXT,mode TEXT,lease INTEGER DEFAULT 0,owner TEXT,answer TEXT,history TEXT,sent_mid INTEGER,PRIMARY KEY(chat,mid))',
+      'CREATE INDEX IF NOT EXISTS group_ai_recent ON group_ai_replies(chat,mode,stamp,author)',
+      'CREATE INDEX IF NOT EXISTS group_ai_reply_id ON group_ai_replies(chat,sent_mid)',
+      'CREATE INDEX IF NOT EXISTS group_ai_expiry ON group_ai_replies(stamp)',
+      'CREATE TABLE IF NOT EXISTS group_ai_checks(revision TEXT PRIMARY KEY, attempts INTEGER,stamp INTEGER,ru INTEGER DEFAULT 0,uz INTEGER DEFAULT 0,ru_model TEXT,uz_model TEXT)',
+      'CREATE TABLE IF NOT EXISTS group_welcomes(chat INTEGER,author INTEGER,joined INTEGER,mid INTEGER,due INTEGER,PRIMARY KEY(chat,author,joined))',
+      'CREATE INDEX IF NOT EXISTS group_welcome_due ON group_welcomes(due) WHERE due IS NOT NULL'
+    ];
+    initialized.set(db, (async () => { for (const s of sql) await db.prepare(s).run(); })().catch(e => { initialized.delete(db); throw e; }));
+  }
+  return initialized.get(db);
+}
+export async function groupAIStatus(store) {
+  await ready(store.db);
+  return await store.first('SELECT revision,ru,uz,ru_model,uz_model,attempts FROM group_ai_checks WHERE revision=?',aiRevision) ||
+    { revision: aiRevision, ru:0, uz:0, attempts:0 };
+}
+export async function expireGroupActivity(env,store) {
+  await ready(store.db);
+  await deleteDueWelcomes(env,store);
+  await store.db.batch([
+    store.stmt('DELETE FROM group_activity WHERE stamp < unixepoch()-600'),
+    store.stmt('DELETE FROM group_ai_turns WHERE stamp < unixepoch()-600'),
+    store.stmt('DELETE FROM group_ai_replies WHERE stamp < unixepoch()-600')
+  ]);
+  await verifyGroupModels(env,store);
+}
+const group = type => type === 'group' || type === 'supergroup';
+const admin = role => role === 'administrator' || role === 'creator';
+const member = (env, chat, user) => telegram(env, 'getChatMember', { chat_id: chat, user_id: user });
+
+async function settings(store, chat) {
+  await ready(store.db);
+  return store.first(`SELECT COALESCE(p.enabled,0) enabled, COALESCE(p.welcome,0) welcome,
+    p.greeting,e.template,COALESCE(e.ai,p.enabled OR p.welcome,0) ai
+    FROM (SELECT ? AS chat) base LEFT JOIN group_preferences p USING(chat) LEFT JOIN group_extras e USING(chat)`,chat);
+}
+
+async function panel(env, chat, settings, messageId) {
+  const { enabled, welcome, ai } = settings;
+  const self = await member(env,chat.id,Number(botToken(env).split(':')[0]));
+  const button = (text, value) => ({text,callback_data:'af:'+value});
+  const warning = chat.type !== 'supergroup' ? 'Vaqtincha yozishni cheklash uchun superguruh kerak.'
+    : !admin(self.status) || self.status !== 'creator' && (!self.can_delete_messages || !self.can_restrict_members)
+      ? 'Botga administrator maqomi, xabarlarni o‘chirish va a’zolarni cheklash huquqlarini bering.' : '';
+  const text = ['🛡 Guruh sozlamalari','',
+    '60 soniyada 5 ta bir xil xabar — 1 daqiqaga yozish cheklanadi.',
+    '5 soniyada 10 tagacha xabar mumkin. Ortiqchasi o‘chiriladi.',
+    'Salomlashuv 5 daqiqadan so‘ng avtomatik o‘chiriladi.',
+    'Asl salomlashuv postiga javoban /salom_namuna yuboring. Standart matn: /salom reset.',
+    'AI bilan suhbat: /ai savol, botni belgilang yoki uning xabariga javob bering.',warning].filter(Boolean).join('\n');
+  const toggles = [[button('Spamdan himoya · '+(enabled?'✅':'❌'),enabled?'off':'on')],
+    [button('Salomlashuv · '+(welcome?'✅':'❌'),welcome?'quiet':'greet')],
+    [button('AI yordamchi · '+(ai?'✅':'❌'),ai?'ai_off':'ai_on')]];
+  await telegram(env,messageId?'editMessageText':'sendMessage',{chat_id:chat.id,...(messageId?{message_id:messageId}:{}),
+    text,reply_markup:{inline_keyboard:toggles}}).catch(e=>{if (!(messageId && e.telegramCode===400)) throw e;});
+}
+export async function groupCallback(env,store,q) {
+  if (!q.data?.startsWith('af:')) return false;
+  const chat=q.message?.chat;
+  if (!group(chat?.type) || !admin((await member(env,chat.id,q.from.id)).status)) {
+    await telegram(env,'answerCallbackQuery',{callback_query_id:q.id,text:'Buni faqat guruh administratori sozlay oladi.',show_alert:true}); return true;
+  }
+  await ready(store.db);
+  const value=q.data.slice(3);
+  const choices={on:['group_preferences','enabled',1],off:['group_preferences','enabled',0],
+    greet:['group_preferences','welcome',1],quiet:['group_preferences','welcome',0],
+    ai_on:['group_extras','ai',1],ai_off:['group_extras','ai',0]};
+  if (Object.hasOwn(choices,value)) {
+    const [table,column,next]=choices[value];
+    await store.stmt(`INSERT INTO ${table}(chat,${column}) VALUES(?,?) ON CONFLICT(chat) DO UPDATE SET ${column}=excluded.${column}`,chat.id,next).run();
+  }
+  await telegram(env,'answerCallbackQuery',{callback_query_id:q.id,text:'Joriy sozlamalar'});
+  await panel(env,chat,await settings(store,chat.id),q.message.message_id);
+  return true;
+}
+
+async function fingerprint(m) {
+  const media=m.photo?.at(-1) || m.sticker || m.document || m.video || m.video_note || m.animation || m.voice || m.audio;
+  const content=m.text || m.caption || m.poll?.question || m.dice?.emoji || m.contact?.phone_number;
+  const value=[content?.normalize('NFKC').toLowerCase().trim().replace(/\s+/gu,' '),media?.file_unique_id].filter(Boolean).join('\n');
+  if (!value) return null;
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(value))), b=>b.toString(16).padStart(2,'0')).join('');
+}
+
+async function moderate(env,store,m) {
+  const chat=m.chat.id, mid=m.message_id, author=m.from.id;
+  const hash=await fingerprint(m);
+  // Decide both limits in the same D1 transaction, scoped to a sender and chat.
+  const results=await store.db.batch([
+    store.stmt('INSERT INTO group_activity(chat,mid,author,fingerprint) VALUES(?,?,?,?) ON CONFLICT DO NOTHING',chat,mid,author,hash),
+    store.stmt(`UPDATE group_activity SET blocked=(SELECT CASE
+      WHEN count(*) FILTER (WHERE fingerprint=?)=5 THEN 2
+      WHEN count(*) FILTER (WHERE fingerprint=?)>5 OR count(*) FILTER (WHERE stamp>unixepoch()-5)>10 THEN 1 ELSE 0 END
+      FROM group_activity WHERE chat=? AND author=? AND stamp>unixepoch()-60)
+      WHERE chat=? AND mid=? AND blocked IS NULL`,hash,hash,chat,author,chat,mid),
+    store.stmt('SELECT blocked,stamp FROM group_activity WHERE chat=? AND mid=?',chat,mid)
+  ]);
+  const {blocked,stamp}=results[2].results[0];
+  if (!blocked) return false;
+  if (blocked === 3) return true;
+  const person=await member(env,chat,author);
+  if (admin(person.status)) return false;
+  // Retried webhooks always use the original expiry. Telegram treats <30s as permanent.
+  if (blocked===2 && m.chat.type==='supergroup' && person.status==='member' && stamp+60-Date.now()/1000>31) {
+    await telegram(env,'restrictChatMember',{chat_id:chat,user_id:author,permissions:{can_send_messages:false},
+      use_independent_chat_permissions:true,until_date:stamp+60}).catch(e=>{if (![400,403].includes(e.telegramCode)) throw e;});
+  }
+  await telegram(env,'deleteMessage',{chat_id:chat,message_id:mid}).catch(e=>{if (![400,403].includes(e.telegramCode)) throw e;});
+  await store.stmt('UPDATE group_activity SET blocked=3 WHERE chat=? AND mid=?',chat,mid).run();
+  return true;
+}
+
+export async function groupMembership(env,store,config,event) {
+  const joined = state => ['member','creator','administrator'].includes(state?.status) || state?.status==='restricted' && state.is_member;
+  if (group(event.chat?.type) && !joined(event.old_chat_member) && joined(event.new_chat_member)) {
+    await welcomeMembers(env,store,config,await settings(store,event.chat.id),event.chat,[event.new_chat_member.user],event.date);
+  }
+}
+
+export async function groupMessage(env,store,config,m) {
+  if (!group(m.chat?.type)) return;
+  const chat=m.chat.id;
+  const prefs=await settings(store,chat);
+  if (m.new_chat_members) {
+    await welcomeMembers(env,store,config,prefs,m.chat,m.new_chat_members,m.date,m.message_thread_id);
+    return;
+  }
+  if (!m.from?.id || m.sender_chat || m.from.is_bot || m.left_chat_member) return;
+  const command=/^\/(antiflood|chat_on|salom_namuna|salom)(?:@([a-z0-9_]+))?(?:\s|$)/i.exec(m.text || '');
+  if (command && (!command[2] || command[2].toLowerCase() === config.name?.toLowerCase()) && admin((await member(env,chat,m.from.id)).status)) {
+    switch (command[1].toLowerCase()) {
+      case 'chat_on':
+        await store.db.batch([
+          store.stmt('INSERT INTO group_preferences(chat,enabled,welcome) VALUES(?,1,1) ON CONFLICT(chat) DO UPDATE SET enabled=1,welcome=1',chat),
+          store.stmt('INSERT INTO group_extras(chat,ai) VALUES(?,1) ON CONFLICT(chat) DO UPDATE SET ai=1',chat)
+        ]);
+        break;
+      case 'salom_namuna':
+        if (!await importWelcome(store,chat,m.reply_to_message)) {
+          await telegram(env,'sendMessage',{chat_id:chat,text:'Rasm va tagmatnli asl xabarga javoban /salom_namuna yuboring. Tagmatnda @name bir marta bo‘lsin (900 belgigacha).'}); return;
+        }
+        break;
+      case 'salom': {
+        const value=m.text.slice(command[0].length).trim();
+        if (!value || value.length>500) {
+          await telegram(env,'sendMessage',{chat_id:chat,text:'Masalan: /salom Salom, @name! Standart matn uchun: /salom reset.'}); return;
+        }
+        await store.db.batch([
+          store.stmt('INSERT INTO group_preferences(chat,greeting) VALUES(?,?) ON CONFLICT(chat) DO UPDATE SET greeting=excluded.greeting',chat,value==='reset'?null:value),
+          store.stmt('UPDATE group_extras SET template=NULL WHERE chat=?',chat)
+        ]);
+        break;
+      }
+    }
+    await panel(env,m.chat,await settings(store,chat)); return;
+  }
+  if (!['text','caption','sticker','photo','video','video_note','audio','voice','document','animation','contact','location','poll','dice','venue','game'].some(key=>m[key]!=null)) return;
+  if (prefs.enabled && await moderate(env,store,m)) return;
+  if (prefs.ai) await answerGroupQuestion(env,store,config,m);
+}
diff --git a/src/group-welcome.mjs b/src/group-welcome.mjs
new file mode 100644
index 0000000..e7abf50
--- /dev/null
+++ b/src/group-welcome.mjs
@@ -0,0 +1,110 @@
+import { telegram } from './telegram.mjs';
+
+const banner = '/assets/donat/catalog/chat-welcome.jpg?v=hd15';
+const introduction = '💬 Salom @name\nguruhimizga xush kelibsiz\nqoidalarga amal qiling ❗';
+const links = 'GOLD SHOP- @arslansavdo\nAKK SAVDO - @arslanakk\nKANAL @arslan_so2';
+const footer = 'Admin @khblyv ⚡';
+const caption = [introduction, links, footer].join('\n\n');
+
+function style(type, part) {
+  return { type, offset: caption.indexOf(part), length: part.length };
+}
+
+const defaultTemplate = { caption, entities: [
+  style('bold', introduction), style('italic', introduction),
+  style('blockquote', links), style('bold', links), style('italic', links),
+  ...['@arslansavdo', '@arslanakk', '@arslan_so2', '@khblyv'].map(tag => style('mention', tag)),
+  style('bold', footer)
+] };
+
+export function personalized(template, user) {
+  const start = template.caption.indexOf('@name');
+  const end = start + 5;
+  const name = user.username ? '@' + user.username : user.first_name || 'Do‘st';
+  const delta = name.length - 5;
+  const entities = [];
+  for (const entity of template.entities) {
+    const a = entity.offset, b = a + entity.length;
+    if (b <= start) entities.push(entity);
+    else if (a >= end) entities.push({ ...entity, offset: a + delta });
+    else if (a <= start && b >= end && !['mention', 'text_mention', 'text_link'].includes(entity.type)) {
+      entities.push({ ...entity, length: entity.length + delta });
+    }
+  }
+  entities.push(user.username ? { type: 'mention', offset: start, length: name.length }
+    : { type: 'text_mention', offset: start, length: name.length,
+        user: { id: user.id, is_bot: false, first_name: name } });
+  entities.sort((a,b) => a.offset - b.offset || b.length - a.length);
+  return { caption: template.caption.slice(0,start) + name + template.caption.slice(end), caption_entities: entities };
+}
+
+export async function importWelcome(store, chat, original) {
+  const text = original?.caption;
+  if (!original?.photo?.length || typeof text !== 'string' || text.split('@name').length !== 2 ||
+      text.length > 900) return false;
+  const image = original.photo.at(-1);
+  const template = { photo:image.file_id, width:image.width, version:2, caption:text, entities:original.caption_entities || [] };
+  await store.db.batch([
+    store.stmt('INSERT INTO group_extras(chat,template) VALUES(?,?) ON CONFLICT(chat) DO UPDATE SET template=excluded.template', chat, JSON.stringify(template)),
+    store.stmt('INSERT INTO group_preferences(chat,welcome,greeting) VALUES(?,1,NULL) ON CONFLICT(chat) DO UPDATE SET welcome=1,greeting=NULL',chat)
+  ]);
+  return true;
+}
+
+async function sendWelcome(env, config, prefs, chat, user, thread) {
+  const dest = { chat_id: chat.id, ...(thread ? { message_thread_id: thread } : {}) };
+  if (prefs.greeting) {
+    const text = prefs.greeting.replace(/@name|\{ism\}|\{guruh\}/g, key =>
+      key === '{guruh}' ? chat.title || 'ARSLAN' : user.username ? '@' + user.username : user.first_name || 'Do‘st');
+    return telegram(env, 'sendMessage', { ...dest, text });
+  }
+  const template = prefs.template ? JSON.parse(prefs.template) : defaultTemplate;
+  const branded = ['@arslansavdo','@arslanakk','@arslan_so2'].every(tag=>template.caption.includes(tag));
+  const useHD = !template.photo || branded && (template.version!==2 || template.width<1000);
+  const body = { ...dest, photo: useHD ? new URL(banner, config.app).href : template.photo, ...personalized(template,user) };
+  try { return await telegram(env, 'sendPhoto', body); }
+  catch (error) {
+    if (error.telegramCode !== 400 || !body.caption_entities.some(e => e.type === 'custom_emoji')) throw error;
+    return telegram(env, 'sendPhoto', { ...body, caption_entities: body.caption_entities.filter(e => e.type !== 'custom_emoji') });
+  }
+}
+
+export async function welcomeMembers(env,store,config,prefs,chat,users,date,thread) {
+  if (!prefs.welcome) return;
+  const joined = date || Math.floor(Date.now()/1000);
+  for (const user of users) {
+    if (!user.id || user.is_bot) continue;
+    const claim = await store.first(`INSERT INTO group_welcomes(chat,author,joined)
+      SELECT ?,?,? WHERE NOT EXISTS (SELECT 1 FROM group_welcomes WHERE chat=? AND author=? AND joined BETWEEN ? AND ?)
+      ON CONFLICT DO NOTHING RETURNING joined`,chat.id,user.id,joined,chat.id,user.id,joined-2,joined+2);
+    if (!claim) continue;
+    let sent;
+    try { sent = await sendWelcome(env,config,prefs,chat,user,thread); }
+    catch (error) {
+      await store.stmt('DELETE FROM group_welcomes WHERE chat=? AND author=? AND joined=? AND mid IS NULL',chat.id,user.id,joined).run();
+      throw error;
+    }
+    await store.stmt('UPDATE group_welcomes SET mid=?,due=unixepoch()+300 WHERE chat=? AND author=? AND joined=?',
+      sent.message_id,chat.id,user.id,joined).run();
+  }
+}
+
+export async function deleteDueWelcomes(env, store) {
+  const rows = await store.all('SELECT chat,author,joined,mid FROM group_welcomes WHERE due<=unixepoch() ORDER BY due LIMIT 80');
+  for (let i = 0; i < rows.length; i += 5) {
+    await Promise.all(rows.slice(i,i+5).map(async row => {
+      const id = [row.chat, row.author, row.joined];
+      try {
+        await telegram(env, 'deleteMessage', { chat_id: row.chat, message_id: row.mid });
+      } catch (error) {
+        if (error.telegramCode !== 400) {
+          await store.stmt('UPDATE group_welcomes SET due=unixepoch()+? WHERE chat=? AND author=? AND joined=?',
+            error.telegramCode === 403 ? 300 : 60,...id).run();
+          return;
+        }
+      }
+      await store.stmt('UPDATE group_welcomes SET due=NULL WHERE chat=? AND author=? AND joined=?',...id).run();
+    }));
+  }
+  await store.stmt('DELETE FROM group_welcomes WHERE joined<unixepoch()-172800').run();
+}
