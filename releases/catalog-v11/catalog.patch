diff --git a/tests/catalog-browser.py b/tests/catalog-browser.py
new file mode 100644
index 0000000..56802cf
--- /dev/null
+++ b/tests/catalog-browser.py
@@ -0,0 +1,109 @@
+"""Mobile storefront regression tests against a local release, with isolated order fixtures."""
+import json
+import os
+import threading
+from functools import partial
+from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+from playwright.sync_api import sync_playwright, expect
+
+PUBLIC = Path(__file__).resolve().parents[1] / "public"
+ITEMS = json.loads((PUBLIC / "assets/donat/catalog.json").read_text())["items"]
+
+
+class QuietHandler(SimpleHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+
+def check(browser, url, width, language):
+    page = browser.new_page(viewport={"width": width, "height": 780}, reduced_motion="reduce")
+    errors = []
+    page.on("pageerror", lambda error: errors.append(str(error)))
+    page.add_init_script(f"localStorage.setItem('ab-lang', '{language}')")
+    page.route("**/*", lambda route: route.continue_() if route.request.url.startswith(url) else route.abort())
+    page.goto(url)
+    expect(page.locator("[data-product]")).to_have_count(len(ITEMS))
+    assert page.evaluate("document.documentElement.scrollWidth <= innerWidth")
+    expect(page.locator("#catalog-order")).to_be_hidden()
+    for item in ITEMS:
+        tile = page.locator(f'button[data-product="{item["id"]}"]')
+        assert tile.locator("img").evaluate("img => img.complete && img.naturalWidth > 0")
+        tile.click()
+        expect(page.locator("#product-detail")).to_be_visible()
+        expect(page.locator("#product-next")).to_be_visible()
+        page.locator("#close-sheet").click()
+    title = "ID orqali Gold" if language == "uz" else "Gold по ID"
+    page.locator("#shop-search").fill(title)
+    expect(page.locator("[data-product]")).to_have_count(1)
+    page.locator('[data-product="gold_id"]').click()
+    expect(page.locator("#sheet-title")).to_have_text(title)
+    page.locator("#product-detail").fill("12345678")
+    for target in ["gold_pass", "spin_coins", "gold_id"]:
+        page.locator(f'[data-core-product="{target}"]').click()
+        expect(page.locator("#product-detail")).to_have_value("12345678")
+        expect(page.locator("#selected-price")).to_have_text("—")
+        expect(page.locator("#product-next")).to_be_disabled()
+    page.locator('[data-option="100"]').first.click()
+    expect(page.locator("#product-next")).to_be_enabled()
+    page.locator("#product-next").click()
+    expect(page.locator("#submit-donat-payment")).to_be_disabled()
+    page.locator("#back-product").click()
+    expect(page.locator("#product-detail")).to_have_value("12345678")
+    page.locator("#close-sheet").click()
+    page.locator("#clear-search").click()
+    page.locator('#shop-filters [data-category="games"]').click()
+    expect(page.locator("[data-product]")).to_have_count(4)
+    page.locator('#shop-filters [data-category="services"]').click()
+    expect(page.locator("[data-product]")).to_have_count(6)
+    assert not errors, errors
+    page.close()
+
+
+def check_active_order(browser, url):
+    page = browser.new_page(viewport={"width": 390, "height": 780}, reduced_motion="reduce")
+    errors = []
+    page.on("pageerror", lambda error: errors.append(str(error)))
+    page.add_init_script("window.Telegram = {WebApp: {initData:'local-test',initDataUnsafe:{}}}")
+    order = dict(id=42, product="gold_id", option_label="100 Gold", amount=24990, detail="12345678",
+                 method="uzcard", status="pending", created_at="2026-11-21T12:00:00Z")
+    payment = dict(id=7, donat_order_id=42, kind="donat", method="uzcard", status="pending", invoice_checking=0)
+    def route_request(route):
+        address = route.request.url
+        if not address.startswith(url):
+            return route.abort()
+        fixtures = {"config": {"arslanBoostApi": True}, "state": {"payments": [payment]},
+                    "donat/state": {"orders": [order]}}
+        if "/api/" in address:
+            return route.fulfill(json=fixtures.get(address.split("/api/")[1], {}))
+        route.continue_()
+    page.route("**/*", route_request)
+    page.goto(url)
+    row = page.locator("#catalog-order")
+    expect(row).to_contain_text("To‘lov kutilmoqda")
+    payment["invoice_checking"] = 1
+    page.locator('#service-switch [data-service="donat"]').click()
+    expect(row).to_contain_text("To‘lov tekshirilmoqda")
+    row.click()
+    expect(page.locator("#sheet-body")).to_contain_text("ID orqali Gold")
+    page.locator("#close-sheet").click()
+    order["status"] = "fulfilled"
+    page.locator('#service-switch [data-service="donat"]').click()
+    expect(row).to_be_hidden()
+    assert not errors, errors
+    page.close()
+
+
+if __name__ == "__main__":
+    server = ThreadingHTTPServer(("127.0.0.1", 0), partial(QuietHandler, directory=PUBLIC))
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    url = f"http://127.0.0.1:{server.server_port}/"
+    with sync_playwright() as playwright:
+        browser = playwright.chromium.launch(executable_path=os.environ.get("CHROME_BIN"))
+        for width, language in [(320, "ru"), (390, "uz"), (430, "ru")]:
+            check(browser, url, width, language)
+        check_active_order(browser, url)
+        browser.close()
+    server.shutdown()
+    print("Passed: ten products, Standoff package reset and checkout, RU/UZ search, filters, and active order.")
