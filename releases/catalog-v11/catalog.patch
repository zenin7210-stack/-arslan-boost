+test('Chat AI answers arithmetic offline, handles languages, quotes, quotas and retries',async t=>{
+  const outbound=[],modelCalls=[];
+  let failPrimary=false, failDelivery=false, seq=0, messageId=500;
+  const sys=app({AI:{run:async(model,input)=>{
+    modelCalls.push({model,messages:input.messages});
+    if(failPrimary && model.includes('120b'))throw Error('503');
+    if(model.includes('120b'))return {choices:[{message:{reasoning_content:'internal',content:'Первый ответ.'}}]};
+    return {response:'Zaxira javobi.'};
+  }}});
+  t.mock.method(globalThis,'fetch',async(url,opts)=>{
+    const method=url.split('/').at(-1), body=JSON.parse(opts.body);
+    if (method==='getChatMember')return Response.json({ok:true,result:{status:'administrator',can_delete_messages:true,can_restrict_members:true}});
+    if(failDelivery && method==='sendMessage'){failDelivery=false;return Response.json({ok:false,error_code:503},{status:503});}
+    if(method==='sendMessage')outbound.push(body.text);
+    return Response.json({ok:true,result:{message_id:++messageId}});
+  });
+  const chat={type:'supergroup',id:-100213};
+  const message=(text,extra={},id=++seq)=>sys.webhook({message:{chat,from:{id:81},text,message_id:id,...extra}});
+  await message('/chat_on');
+  await sys.webhook({callback_query:{id:'no-flood',from:{id:40},data:'af:off',message:{chat,message_id:1}}});
+  const last=()=>outbound.at(-1);
+  await message('/ai 2+2?');assert.equal(last(),'4');assert.equal(modelCalls.length,0);
+  await message('/ai Сколько будет (2+3)×4?');assert.equal(last(),'20');
+  await message('/ai русча'); 
+  await message('/ai привет!');assert.match(last(),/Привет/);
+  await message('/ai салом');assert.match(last(),/Salom/);
+  await message('/ai Почему контролируют центр?');
+  const parent=messageId;
+  assert.equal(last(),'Первый ответ.');
+  assert.match(modelCalls.at(-1).messages[0].content,/Likely answer language: Russian/);
+  await message('А если центр закрыт?',{reply_to_message:{message_id:parent,from:{id:900000,is_bot:true},text:'Первый ответ.'}});
+  assert.ok(modelCalls.at(-1).messages.some(x=>x.role==='user'&&x.content.includes('контролируют центр')));
+  failPrimary=true;
+  await message('/ai ўйинда нима керак?');assert.equal(last(),'Zaxira javobi.');
+  assert.match(modelCalls.at(-1).messages[0].content,/Likely answer language: Uzbek/);
+  failDelivery=true;
+  const retry=++seq;
+  const count=modelCalls.length;
+  await message('/ai nima uchun?',{},retry);
+  await message('/ai nima uchun?',{},retry);
+  assert.equal(last(),'Zaxira javobi.');assert.equal(modelCalls.length,count+2);
+  await message('/ai nima uchun?',{},retry);assert.equal(modelCalls.length,count+2);
+  for(let i=0;i<13;i++)await message('/ai Что такое центр '+i+'?');
+  assert.match(last(),/через минуту/);
+  await message('/ai 2+2');assert.equal(last(),'4');
+  sys.db.prepare('UPDATE group_ai_replies SET stamp=unixepoch()-65 WHERE author=81').run();
+  await message('/ai Почему?');assert.equal(last(),'Zaxira javobi.');
+  const check=await sys.send('/healthz?chat_ai=1',null,{},'GET');
+  assert.equal(check.data.attempts,0);
+});
