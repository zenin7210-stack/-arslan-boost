+}
+.app:has(#donat.active) {
+  display: flex;
+  flex-direction: column;
+  min-height: 100dvh;
+  padding-bottom: calc(82px + max(var(--safe), var(--tg-content-safe-area-inset-bottom, 0px)));
+}
+#donat.active { flex: 1; display: flex; flex-direction: column; }
+.app:has(#donat.active) .tg-head {
+  height: 44px; margin: 5px -2px 0; padding: 0 7px;
+  border: 1px solid #235777; border-radius: 26px; background: #041929;
+}
+.app:has(#donat.active) .tg-head .brand-icon {
+  display: block; position: absolute; right: 45px; width: 32px; height: 32px;
+  object-fit: contain; border: 1px solid #51cfe6; border-radius: 50%; background: #02101c; box-shadow: none;
+}
+.app:has(#donat.active) .tg-head .tg-icon { width: 30px; height: 30px; flex-basis: 30px; border: 1px solid #245778; background: #10334a; }
+.app:has(#donat.active) .tg-head .brand-text strong { font-size: 15px; }
+.app:has(#donat.active) .tg-head .brand-text small { margin-top: 0; font-size: 10px; }
+.app:has(#donat.active) .service-switch {
+  margin: 8px 4% 9px; gap: 0; padding: 0; background: #061e31; border: 1px solid #407fa5; border-radius: 24px;
+}
+.app:has(#donat.active) .service-switch button { min-height: 34px; border-radius: 22px; border: 1px solid transparent; background: transparent; }
+.app:has(#donat.active) .service-switch .ui-icon { display: inline-block; width: 16px; height: 16px; }
+.app:has(#donat.active) .service-switch button[aria-pressed="true"], .shop-page .category-tabs button[aria-pressed="true"], body:has(#donat.active) .bottom .nav.active {
+  color: white; border: 1px solid #48e6ff; background: linear-gradient(145deg,#00b7e7,#0074cb 78%); box-shadow: inset 0 0 7px #34dcff7a, 0 0 7px #008ae73b;
+}
+.shop-titlebar { gap: 10px; min-height: 40px; margin: 0 3px 7px; }
+.shop-titlebar .gold-mark { width: 52px; height: 32px; padding-right: 8px; border-right: 1px solid #22cfea; border-radius: 0; }
+.shop-titlebar h1 { font-size: clamp(23px,6vw,31px); }
+.shop-titlebar p { font-size: clamp(11px,2.75vw,14px); }
+.shop-page .searchbox, .shop-page .category-tabs button {
+  border-color: #4c83aa; background: linear-gradient(155deg,#0c2b41,#061c2e); border-radius: 22px;
+}
+.shop-page .searchbox { margin: 0 2px 8px; min-height: 35px; }
+.shop-banner { aspect-ratio: 5.38; border: 1px solid #55c4ff; border-radius: 13px; box-shadow: 0 0 6px #0088c746; margin-bottom: 7px; }
+.category-tabs { gap: 5px; margin-bottom: 8px; }
+.shop-page .category-tabs button { min-height: 33px; }
+.product-grid { gap: 6px; }
+.shop-page .product-card {
+  overflow: hidden; padding: 0 0 5px; border-radius: 12px; min-height: 0;
+  border-color: var(--edge,#53bcff); background: linear-gradient(150deg,var(--aura,#163a56),var(--card-base,#082133));
+  box-shadow: inset 0 0 4px var(--rim,#1685c255); align-items: stretch; justify-content: flex-start;
+}
+.shop-page .product-card.pass { --edge:#8ec2e1; --aura:#213c49; --card-base:#112634; }
+.shop-page .product-card .card-art { width: 100%; height: auto; aspect-ratio: 2.95; object-fit: cover; border-radius: 0; }
+.shop-page .product-card:is(.gold,.id) .card-art { aspect-ratio: 2.28; object-fit: cover; }
+.shop-page .product-card.pass .card-art { aspect-ratio: 2.76; object-fit: cover; }
+.shop-page .product-card .card-name { margin: 3px 2px 0; font-size: clamp(10px,2.7vw,14px); font-weight: 730; line-height: 1.12; }
+.shop-page .product-card:is(.gold,.id) .card-name { margin-block: auto; padding-top: 5px; }
+.shop-page .product-card .card-desc { margin: 2px 1px 0; color: #e0ebf6; font-size: clamp(9px,2.45vw,12px); line-height: 1.12; }
+.section-title { margin: 9px 2px 7px; }
+.shop-page .section-title .ui-icon, .shop-page .show-all { color: #26dded; }
+.game-grid { gap: 5px; }
+.game-art { aspect-ratio: 1.96; object-fit: cover; border: 1px solid #82b5d6; border-radius: 9px; }
+.game-name { color: #fff; font-size: clamp(9px,2.55vw,13px); font-weight: 600; }
+.catalog-order {
+  display: flex; align-items: center; gap: 7px; width: 100%; margin-top: auto; position: relative; top: 6px;
+  padding: 5px 10px; min-height: 34px; border: 1px solid #4b90bb; border-radius: 18px;
+  color: #f7fbff; background: linear-gradient(110deg,#0a2338,#062033); text-align: left; font-size: clamp(10px,2.8vw,13px);
+}
+.catalog-order[hidden] { display: none; }
+.catalog-order .ui-icon { width: 15px; height: 15px; }
+.catalog-order-status { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; }
+.catalog-order-status::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #ffc222; }
+.catalog-order:is([data-status="paid"],[data-status="in_progress"]) .catalog-order-status::before { background: #39d7c4; }
+body:has(#donat.active) .bottom { height: 54px; background: #051c2ff5; border-color: #4284ad; }
+@media (prefers-reduced-motion: reduce) { .shop-page { animation: none; } }
+.product-sheet .widget-scroll[data-widget-product] .widget-cover {
+  aspect-ratio: auto; max-height: none; background: #071d30;
+}
+.product-sheet .widget-scroll[data-widget-product] .widget-cover img {
+  display: block; width: 100%; height: auto; max-height: 175px; object-fit: contain;
+}
