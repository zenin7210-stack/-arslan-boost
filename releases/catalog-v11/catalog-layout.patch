diff --git a/src/review-channel.mjs b/src/review-channel.mjs
new file mode 100644
index 0000000..f45d459
--- /dev/null
+++ b/src/review-channel.mjs
@@ -0,0 +1,51 @@
+const channel = 'https://t.me/s/arslanotziv';
+
+function photoUrl(style) {
+  const value = /background-image:\s*url\(\s*['"]?(https:\/\/[^'")\s]+)/i.exec(style || '')?.[1];
+  if (!value) return '';
+  try {
+    const url = new URL(value.replaceAll('&amp;', '&'));
+    return /(?:^|\.)(?:t\.me|telegram\.org|telegram-cdn\.org|telesco\.pe)$/.test(url.hostname) ? url.href : '';
+  } catch {
+    return '';
+  }
+}
+
+export async function reviewChannel(request) {
+  if (request.method !== 'GET') return new Response(null, {status: 405, headers: {Allow: 'GET'}});
+  try {
+    const upstream = await fetch(channel, {
+      signal: AbortSignal.timeout(4000),
+      cf: {cacheEverything: true, cacheTtl: 300},
+    });
+    if (!upstream.ok) throw new Error('Channel unavailable');
+    const posts = [];
+    let post;
+    const selector = '.tgme_widget_message[data-post]';
+    const parsed = new HTMLRewriter()
+      .on(selector, {element(el) {
+        const match = /^arslanotziv\/(\d+)$/i.exec(el.getAttribute('data-post') || '');
+        post = match ? {id: Number(match[1]), text: '', photo: ''} : null;
+        el.onEndTag(() => {
+          if (post && (post.text.trim() || post.photo)) {
+            post.text = post.text.trim().replaceAll('&amp;', '&');
+            posts.push(post);
+          }
+          post = null;
+        });
+      }})
+      .on(selector + ' .tgme_widget_message_text', {text(chunk) {
+        if (post && post.text.length < 500) post.text += chunk.text.slice(0, 500 - post.text.length);
+      }})
+      .on(selector + ' .tgme_widget_message_text br', {element() { if (post) post.text += '\n'; }})
+      .on(selector + ' .tgme_widget_message_photo_wrap', {element(el) {
+        if (post && !post.photo) post.photo = photoUrl(el.getAttribute('style'));
+      }})
+      .transform(upstream);
+    await parsed.arrayBuffer();
+    if (!posts.length) throw new Error('No public posts');
+    return Response.json({posts: posts.sort((a, b) => b.id - a.id).slice(0, 5)}, {headers: {'Cache-Control': 'public, max-age=300'}});
+  } catch {
+    return Response.json({posts: []}, {status: 503, headers: {'Cache-Control': 'no-store'}});
+  }
+}
